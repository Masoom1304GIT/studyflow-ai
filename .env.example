# StudyFlow AI -- Environment Variables Template
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# Express server port (default: 5000)
PORT=5000

# Google Gemini 1.5 Flash API key (OPTIONAL)
# Get yours at: https://aistudio.google.com/app/apikey
# If omitted, the app runs fully using the built-in intelligent NLP heuristic
# fallback and pre-built demo study packs -- no API key required for demo use.
GEMINI_API_KEY=your_gemini_api_key_here
